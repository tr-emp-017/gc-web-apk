{
  "expo": {
    "name": "Gadha Chor",
    "slug": "gadha-chor",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "gadha-chor",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.gadhachor.app",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_NETWORK_STATE",
        "CHANGE_NETWORK_STATE",
        "WAKE_LOCK",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6918a0af-4dc2-4d9d-9a7a-7a4947db3dc2"
      }
    }
  }
}
