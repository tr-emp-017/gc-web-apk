{
  "expo": {
    "name": "Gadha Chor",
    "slug": "gadha-chor",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "gadha-chor",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.gadhachor.app",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_NETWORK_STATE",
        "CHANGE_NETWORK_STATE",
        "WAKE_LOCK",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-audio",
      "expo-screen-orientation",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/favicon.png"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6918a0af-4dc2-4d9d-9a7a-7a4947db3dc2"
      }
    }
  }
}
