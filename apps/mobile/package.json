{
  "name": "@gadha-chor/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo start --android",
    "build": "tsc --noEmit -p tsconfig.json",
    "dev": "expo start",
    "eas-build-post-install": "pnpm --filter @gadha-chor/game-engine build && pnpm --filter @gadha-chor/shared-types build && pnpm --filter @gadha-chor/shared-utils build",
    "export:web": "expo export -p web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@expo/metro-runtime": "^57.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@gadha-chor/game-engine": "workspace:*",
    "@gadha-chor/shared-types": "workspace:*",
    "@gadha-chor/shared-utils": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.21",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-linking": "~57.0.9",
    "expo-navigation-bar": "~57.0.2",
    "expo-router": "^57.0.20",
    "expo-screen-orientation": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-incall-manager": "^4.2.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "^0.21.2",
    "react-native-webrtc": "^124.0.8",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "expo-modules-autolinking": "~57.0.12"
  }
}
