{
  "name": "@gadha-chor/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo start --android",
    "build": "tsc --noEmit -p tsconfig.json",
    "dev": "expo start",
    "eas-build-post-install": "pnpm --filter @gadha-chor/game-engine build && pnpm --filter @gadha-chor/shared-types build && pnpm --filter @gadha-chor/shared-utils build",
    "export:web": "expo export -p web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@expo/metro-runtime": "^4.0.1",
    "@expo/vector-icons": "^14.0.2",
    "@gadha-chor/shared-types": "workspace:*",
    "@gadha-chor/shared-utils": "workspace:*",
    "expo": "^52.0.0",
    "expo-asset": "~11.0.1",
    "expo-constants": "~17.0.3",
    "expo-linking": "~7.0.3",
    "expo-router": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "^0.76.5",
    "react-native-incall-manager": "^4.1.0",
    "react-native-safe-area-context": "~4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "^0.19.13",
    "react-native-webrtc": "^124.0.6",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12"
  }
}
